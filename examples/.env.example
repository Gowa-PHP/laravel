# GOWA Server Configuration
GOWA_BASE_URL=https://gowa.yourcompany.com
GOWA_USERNAME=admin
GOWA_PASSWORD=secret
GOWA_TIMEOUT=15
GOWA_WEBHOOK_SECRET=your_hmac_secret
GOWA_WEBHOOK_PATH=webhooks/gowa

# Target Device & Test Details
GOWA_DEVICE_ID=my-instance-uuid
GOWA_RECIPIENT=5511999998888
GOWA_TEST_MESSAGE="Hello from gowa-laravel!"

# Set to 1 to bypass confirmation prompt in send-text.php
GOWA_SEND_MESSAGE=0
